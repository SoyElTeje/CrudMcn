# ============================================
# Variables de Entorno para Docker
# ============================================
# Copia este archivo a .docker.env y configura los valores reales
# Uso: docker-compose --env-file .docker.env up

# ============================================
# Base de Datos (SQL Server existente en producción)
# ============================================
# NOTA: La base de datos debe existir previamente
# Configurar con los datos de tu servidor SQL Server existente
# IMPORTANTE: Si la base de datos está en el HOST (fuera del contenedor):
#   - Windows/Mac: usar "host.docker.internal"
#   - Linux: usar la IP del host (ej: "192.168.1.100") o configurar red de Docker
# Si la base de datos está en otro servidor, usar su IP o dominio
#DB_SERVER=host.docker.internal
DB_SERVER=192.168.168.208
DB_PORT=1433
#DB_USER=sa
#DB_PASSWORD=simpleDev!
DB_DATABASE=APPDATA
DB_USER = app_user
DB_PASSWORD = Pd6EdwB%ta
# ============================================
# Aplicación
# ============================================
APP_PORT=3001
PORT=3001
NODE_ENV=production

# ============================================
# Frontend (para build)
# ============================================
# URL donde estará disponible el backend
# IMPORTANTE: Debe ser accesible desde el navegador del usuario
# Si usas Docker, puede ser la IP del servidor o un dominio
# Para acceso local: http://localhost:3001
# Para acceso desde red local: http://192.168.1.6:3001 (cambiar por tu IP)
VITE_API_BASE_URL=http://localhost:3001

# ============================================
# CORS
# ============================================
# Orígenes permitidos (separados por coma)
# Ejemplo: http://localhost:5173,https://tudominio.com
CORS_ORIGIN=*

# ============================================
# JWT (OBLIGATORIO)
# ============================================
# Genera un secret seguro: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# IMPORTANTE: Si el JWT_SECRET contiene $, escapar con $$ (ej: $VAR se convierte en $$VAR)
# Docker Compose interpreta $ como inicio de variable de entorno
# Para el valor original: dNG&B%x7&7k8hXeWV2nBfh8JkEG8muBBDD&hYYWSnY&rphyem%&F8tEt@6$GCjw7
# Escapado correctamente (sin comillas, solo $$):
JWT_SECRET='dNG&B%x7&7k8hXeWV2nBfh8JkEG8muBBDD&hYYWSnY&rphyem%&F8tEt@6$GCjw7'
JWT_EXPIRES_IN=24h

# ============================================
# Logging
# ============================================
LOG_LEVEL=info

# ============================================
# Trial (opcional)
# ============================================
TRIAL_DB=BD_ABM1
TRIAL_TABLE=Maquinas

